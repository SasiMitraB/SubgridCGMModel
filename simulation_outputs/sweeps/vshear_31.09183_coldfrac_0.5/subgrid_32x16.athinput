# Athena++ (Kokkos version) input file generated by run_parameter_sweep.sh

<comment>
problem   = Kelvin-Helmholtz instability

<job>
basename = KH_SG_32x16

<mesh>
nghost    = 3
nx1       = 16
x1min     = -5.0
x1max     =  5.0
ix1_bc    = periodic
ox1_bc    = periodic

nx2       = 32
x2min     = -10.0
x2max     =  10.0
ix2_bc    = reflect
ox2_bc    = user

nx3       = 1
x3min     = -0.5
x3max     = 0.5
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 16
nx2       = 32
nx3       = 1

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.4
nlim       = -1
tlim       = 10.0
ndiag      = 5

<hydro>
eos         = ideal
reconstruct = plm
rsolver     = hllc
nscalars    = 2
gamma       = 1.666667
ism_cooling = false
hrate       = 0

<problem>
iprob     = 1
amp       = 0.01
sigma     = 0.25
vx_hot    = 28.265300
vx_cold   = -2.826530
a_char    = 0.0625
rho_cold  = 0.1
rho_hot   = 0.001
press     = 13.925145161290322
cold_frac = 0.5
user_srcs = true

<units>
length_cgs = 3.08568e+18
mass_cgs   = 4.91417e+31
time_cgs   = 3.15576e+13
mu         = 0.62

<output1>
file_type = hst
dt        = 0.01

<output2>
file_type = bin
variable  = hydro_w
dt        = 0.01

<output3>
file_type = bin
variable  = hydro_u
dt        = 0.01

<output4>
file_type = rst
dt        = 1.0
