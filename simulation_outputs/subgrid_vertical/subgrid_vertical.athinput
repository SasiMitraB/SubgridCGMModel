# Athena++ (Kokkos version) input file generated from config.json

<comment>
problem   = Kelvin-Helmholtz instability

<job>
basename    = KH

<mesh>
nghost      = 3
nx1         = 32
x1min       = -10.0
x1max       = 10.0
ix1_bc      = reflect
ox1_bc      = user
nx2         = 16
x2min       = -5.0
x2max       = 5.0
ix2_bc      = periodic
ox2_bc      = periodic
nx3         = 1
x3min       = -0.5
x3max       = 0.5
ix3_bc      = periodic
ox3_bc      = periodic

<meshblock>
nx1         = 32
nx2         = 16
nx3         = 1

<time>
evolution   = dynamic
integrator  = rk2
cfl_number  = 0.4
nlim        = -1
tlim        = 10.0
ndiag       = 5

<hydro>
eos         = ideal
reconstruct = plm
rsolver     = hllc
nscalars    = 2
gamma       = 1.666667
ism_cooling = false
hrate       = 0

<problem>
iprob       = 1
amp         = 0.01
sigma       = 0.25
vx_hot      = 28.2653
vx_cold     = -2.8265
a_char = 0.0625		    # width of tanh profile
#a_char = 0.125
rho_cold    = 0.1
rho_hot     = 0.001
# press = 8.63359		# pressure = 1.380649e-13 dyne cm^-3; 8.63359
press = 13.925145161290322 # Since mu was updated, even pressure should be updated from 8.63359
#cold_frac = 0.16666667	# fraction of region occupied by cold gas
cold_frac = 0.50000000
#cold_frac = 0.3300000
user_srcs   = true

<units>
length_cgs  = 3.08568e+18
mass_cgs    = 4.91417e+31
time_cgs    = 3.15576e+13
mu = 0.62
# This is because we're in plasma and things need to be ionized.

# Units :-
# length = 1 pc = 3.08568e+18 cm
# time   = 1 My  = 3.15576e+13 s
# mass   = 4.91417e+31 g cm^-3 		(this is so that density has units of m_p per cm^3)
# velocity = 9.77793e+4  cm s^-1
# density  = 1.67262e-24 g cm^-3
# energy   = 4.69834e+41 ergs
# power    = 1.48881e+28 erg/s
# energy density/pressure = 1.59916e-14 dyne/cm^2

<output1>
file_type   = hst
dt          = 0.0005

<output2>
file_type   = bin
variable    = hydro_w
dt          = 0.01

<output3>
file_type   = bin
variable    = hydro_u
dt          = 0.01

<output4>
file_type   = rst
dt          = 1.0

