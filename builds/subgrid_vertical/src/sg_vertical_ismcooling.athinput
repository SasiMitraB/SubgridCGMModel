# Athena++ (Kokkos version) input file for vertical hydro KH test with subgrid model

<comment>
problem   = Kelvin-Helmholtz instability (vertical setup)

<job>
basename = KH_vertical

<mesh>
nghost    = 3
nx1       = 128        # Number of zones in X1-direction (horizontal, user boundaries)
x1min     = -10.0       # minimum value of X1
x1max     =  10.0       # maximum value of X1
ix1_bc    = reflect     # inner-X1 boundary flag
ox1_bc    = user        # outer-X1 boundary flag

nx2       = 256        # Number of zones in X2-direction (vertical, periodic)
x2min     = -5.0        # minimum value of X2
x2max     =  5.0        # maximum value of X2
ix2_bc    = periodic    # inner-X2 boundary flag
ox2_bc    = periodic    # outer-X2 boundary flag

nx3       = 1           # Number of zones in X3-direction
x3min     = -0.5        # minimum value of X3
x3max     = 0.5         # maximum value of X3
ix3_bc    = periodic    # inner-X3 boundary flag
ox3_bc    = periodic    # outer-X3 boundary flag

<meshblock>
nx1         = 16
nx2         = 32
nx3         = 1

<time>
evolution  = dynamic    # dynamic/kinematic/static
integrator = rk2
cfl_number = 0.4        # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = -1         # cycle limit
tlim       = 20.00        # time limit
ndiag      = 5        # cycles between diagnostic output

<hydro>
eos         = ideal     # EOS type
reconstruct = plm
rsolver     = hllc      # Riemann-solver to be used
nscalars    = 2         # number of passive scalars in hydro (subgrid model needs 2 scalars)
gamma       = 1.666667  # gamma = C_p/C_v
ism_cooling = true     # subgrid model replaces ISM cooling
hrate       = 0

<problem>
iprob = 1               # flag to select setup
amp   = 0.01            # amplitude of sinusoidal perturbation (vshear/100)
sigma = 0.25            # width of gaussian profile
vx_hot = 28.2653        # hot velocity (shear along Y, read as vx_hot parameter)
vx_cold = -2.8265       # cold velocity (shear along Y, read as vx_cold parameter)
a_char = 0.0625		    # width of tanh profile
rho_cold = 0.1
rho_hot  = 0.001
press = 13.925145161290322 # Since mu was updated, pressure is updated from 8.63359
cold_frac = 0.25
user_srcs = false        # enable Python subgrid model source term call

<units>
length_cgs  = 3.08568e+18
mass_cgs    = 4.91417e+31
time_cgs    = 3.15576e+13
mu = 0.62

<output1>
file_type  = hst       # History data dump
dt         = 0.01    # time increment between outputs

<output2>
file_type  = bin       # bin data dump
variable   = hydro_w   # variables to be output
dt         = 0.01      # time increment between outputs

<output3>
file_type  = bin       # bin data dump
variable   = hydro_u   # variables to be output
dt         = 0.01      # time increment between outputs

<output4>
file_type  = rst       # rstin data dump
dt         = 1.0      # time increment between outputs
